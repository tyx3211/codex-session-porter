{
  "name": "codex-session-porter",
  "version": "0.1.0",
  "description": "Export OpenAI Codex CLI and VS Code chat sessions to HTML, Markdown, or JSONL, with an Ink TUI picker.",
  "type": "module",
  "bin": {
    "cce": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyx3211/codex-session-porter.git"
  },
  "scripts": {
    "build": "tsc && node scripts/chmod-cli.mjs",
    "build:test": "tsc -p tsconfig.test.json",
    "lint": "eslint src test",
    "test": "npm run build && npm run build:test && node --test test-js/**/*.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "verify": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "ink": "^7.0.1",
    "markdown-it": "^14.3.0",
    "react": "^19.2.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "eslint": "^10.2.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0"
  }
}
